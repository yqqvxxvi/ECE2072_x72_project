module proc_tb;
    reg clk, rst;
    reg [8:0] din;
    wire [15:0] R0, R1, R2, R3, R4, R5, R6, R7;
    wire [15:0] bus;
    wire [6:0] HEX5;

    // Instantiate the simple processor
    simple_proc uut (
        .clk(clk),
        .rst(rst),
        .din(din),
        .bus(bus),
        .R0(R0),
        .R1(R1),
        .R2(R2),
        .R3(R3),
        .R4(R4),
        .R5(R5),
        .R6(R6),
        .R7(R7),
        .HEX5(HEX5)
    );

    // Clock generation
    always #5 clk = ~clk;

    // Task to print current state of the processor
    task print_state;
        begin
            $display("Time: %0d", $time);
            $display("R0 = %0d, R1 = %0d, R2 = %0d, R3 = %0d", R0, R1, R2, R3);
            $display("R4 = %0d, R5 = %0d, R6 = %0d, R7 = %0d", R4, R5, R6, R7);
            $display("Bus = %0d, din = %0d, HEX5 = %b", bus, din, HEX5);
            $display("");
        end
    endtask

    initial begin
        // Initialize clock and reset signals
        clk = 0;
        rst = 1;
        din = 9'b000000000; // No instruction loaded initially

        // Release reset after some time
        #10 rst = 0;

        // Test 1: Load immediate value into R0 (MOVI R0, 10)
        // MOVI opcode: 111, Register R0: 000, Immediate: 10
        #10 din = 9'b111000010; // MOVI R0, 10
        #40; // Wait for the instruction to execute
        print_state();

        // Test 2: Load immediate value into R1 (MOVI R1, 15)
        // MOVI opcode: 111, Register R1: 001, Immediate: 15
        #10 din = 9'b111001111; // MOVI R1, 15
        #40;
        print_state();

        // Test 3: Add R0 and R1 and store in R2 (ADD R2, R0, R1)
        // ADD opcode: 001, Rx = 010 (R2), Ry = 001 (R1)
        #10 din = 9'b001010001; // ADD R2, R0, R1
        #40;
        print_state();

        // Test 4: Add immediate value to R0 (ADDI R0, 5)
        // ADDI opcode: 010, Register R0, Immediate: 5
        #10 din = 9'b010000101; // ADDI R0, 5
        #40;
        print_state();

        // End of simulation
        #50;
        $finish;
    end

    // Monitor changes to key signals
    initial begin
        $monitor("Time = %0t | R0 = %d, R1 = %d, R2 = %d, R3 = %d | Bus = %h", $time, R0, R1, R2, R3, bus);
    end

endmodule
