module simple_proc(clk, rst, din, bus, R0, R1, R2, R3, R4, R5, R6, R7);

	// Note: The skeleton you are provided with includes output ports to output the values of the internal 
	// registers R0 - R7, for the purpose of test benching. When instantiating the processor to program your DE10-lite, 
	// you can leave these ports unused.

	// TODO: Declare inputs and outputs:
	input clk, rst;
	input [8:0]din;
	output [15:0] Bus,R0,R1,R2,R3,R4,R5,R6,R7, Bus, G;
	

	// TODO: declare wires:
	wire [15:0] ext_din;
	wire [15:0] alu_result;
	wire [15:0] mux_out;
	wire [3:0] tick;
	wire [2:0] alu_op;
	wire [15:0] reg_data_in;
	wire [8:0] IR; // current instruction

	// register enable signals
	wire r_in_a, r_in_g;
	wire [8:0] reg_in; // instruction register 9 bits
	
	parameter N = 16;
	
	// TODO: instantiate registers: 
	register_n #(.N(9)) IR(.data_in(din), .r_in(reg_in[0]), .clk(clk), .Q(IR), .rst(rst)); // Instruction register
	register_n #(.N(N)) reg0(.data_in(din), .r_in(reg_in[0]), .clk(clk), .Q(R0), .rst(rst)); // general purpose register
	register_n #(.N(N)) reg1(.data_in(din), .r_in(reg_in[1]), .clk(clk), .Q(R1), .rst(rst));
	register_n #(.N(N)) reg2(.data_in(din), .r_in(reg_in[2]), .clk(clk), .Q(R2), .rst(rst));
	register_n #(.N(N)) reg3(.data_in(din), .r_in(reg_in[3]), .clk(clk), .Q(R3), .rst(rst));
	register_n #(.N(N)) reg4(.data_in(din), .r_in(reg_in[4]), .clk(clk), .Q(R4), .rst(rst));
	register_n #(.N(N)) reg5(.data_in(din), .r_in(reg_in[5]), .clk(clk), .Q(R5), .rst(rst));
	register_n #(.N(N)) reg6(.data_in(din), .r_in(reg_in[6]), .clk(clk), .Q(R6), .rst(rst));
	register_n #(.N(N)) reg7(.data_in(din), .r_in(reg_in[7]), .clk(clk), .Q(R7), .rst(rst));
	register_n #(.N(N)) regA(.data_in(mux_out), .r_in(r_in_a), .clk(clk), .Q(bus), .rst(rst));
	register_n #(.N(N)) regG(.data_in(alu_result), .r_in(r_in_g), .clk(clk), .Q(G), .rst(rst));
	
	
